<?xml version="1.0" encoding="utf-8"?>
<Project name="efak">
    <Package name="medical">
        <Key ID="STR_efak_medical_ItemCount_InKit">
            <English>in %1</English>
        </Key>
        <Key ID="STR_efak_medical_Setting_UseFromKit">
            <English>Treat out of this kit</English>
        </Key>
        <Key ID="STR_efak_medical_Setting_UseFromKit_Desc">
            <English>Lets ACE treatments use what is inside\nkits of this type, without taking it out\nfirst.\n\nOff: this kit has to be opened and its\ncontents taken out before they can be\nused, and the medical menu does not\ncount them.</English>
        </Key>
        <Key ID="STR_efak_medical_Setting_KitOwnerOrder">
            <English>Whose kits are used first</English>
        </Key>
        <Key ID="STR_efak_medical_Setting_KitOwnerOrder_Desc">
            <English>Whose kits a treatment reaches into\nfirst, the medic's or the patient's.\n\nLike ACE: the same order as ACE's\nshared equipment setting.\n\nThe patient's kits are never used\nwhere that setting allows the medic's\nsupplies only.</English>
        </Key>
        <Key ID="STR_efak_medical_Setting_KitOwnerOrder_Ace">
            <English>Like ACE (shared equipment)</English>
        </Key>
        <Key ID="STR_efak_medical_Setting_KitOwnerOrder_Medic">
            <English>Medic's kits first</English>
        </Key>
        <Key ID="STR_efak_medical_Setting_KitOwnerOrder_Patient">
            <English>Patient's kits first</English>
        </Key>
        <Key ID="STR_efak_medical_Setting_KitSizeOrder">
            <English>Which kit is used first</English>
        </Key>
        <Key ID="STR_efak_medical_Setting_KitSizeOrder_Desc">
            <English>With several kits, which one a\ntreatment reaches into first.\n\nSmallest first: the IFAK before the\nMFAK, so the big bag stays full the\nlongest.\nBiggest first: the other way round.</English>
        </Key>
        <Key ID="STR_efak_medical_Setting_KitSizeOrder_Smallest">
            <English>Smallest kit first</English>
        </Key>
        <Key ID="STR_efak_medical_Setting_KitSizeOrder_Biggest">
            <English>Biggest kit first</English>
        </Key>
        <Key ID="STR_efak_medical_Setting_UseOrder">
            <English>ACE medical: use kit supplies</English>
        </Key>
        <Key ID="STR_efak_medical_Setting_UseOrder_Desc">
            <English>What a treatment uses up first: loose\nitems or items inside kits.\n\nLoose items come out of the uniform\nfirst, then the vest, then the backpack.\n\nWhich kit goes first is set with\n"Whose kits are used first" and\n"Which kit is used first".</English>
        </Key>
        <Key ID="STR_efak_medical_Setting_UseOrder_Inventory">
            <English>Loose items first, kits last</English>
        </Key>
        <Key ID="STR_efak_medical_Setting_UseOrder_Kits">
            <English>Kits first, loose items last</English>
        </Key>
    </Package>
</Project>
